# ── server ─────────────────────────────────────────────────
PORT=3000
HOST=0.0.0.0
HOST_PORT=3000          # docker host-side port (compose only)
TITLE=ADVADERS

# ── pi-hole v6 (omit both → frontend runs in built-in demo) ─
# PIHOLE_URL=https://pi.hole
# PIHOLE_PASSWORD=changeme
PIHOLE_INSECURE_TLS=false
PIHOLE_QUERY_LENGTH=200

# ── client polling ─────────────────────────────────────────
POLL_INTERVAL_MS=2000

# ── client defaults (theme + sprite picker initial values) ─
DEFAULT_THEME=crt       # crt | minimal | cyber | pop | ascii
DEFAULT_SPRITE=classic  # classic | blocky | dot | glyph
